---
import '../styles/global.css';

import type { WithContext, Person, CreativeWork } from 'schema-dts';
import Header, { type Props as HeaderProps } from '../components/Header.astro';
import SimpleAnalytics from '../components/SimpleAnalytics.astro';
import defaultCoverImage from '../images/marcomontalbano.png';
import { getSocialImage } from '../lib/social-image';

export interface Props {
  /** Frontmatter of a Markdown page using this layout; props passed directly take precedence. */
  frontmatter?: Record<string, any>;
  /** Page title; " - Marco Montalbano" is appended, except when it is the site name itself. */
  title: string;
  /** Falls back to the site's own description. */
  description?: string;
  /** Structured data for search engines. */
  ldJson: WithContext<Person | CreativeWork>;
  /** Full-width cover with the page's title; its image is also the link-preview image. */
  hero?: HeaderProps['hero'];
  /** Marks the page as an article in link previews, with its dates. */
  article?: { publishedAt: Date; updatedAt: Date };
}

// Merge top-level props with frontmatter props
const { frontmatter, ...rest } = Astro.props;
const props = { ...frontmatter, ...rest };

const mainTitle = 'Marco Montalbano';
const { title, description, hero, ldJson, article } = props;

const websiteTitle = `${title != mainTitle ? `${title} - ` : ''}${mainTitle}`;
const websiteDescription =
  description ??
  "Hi everyone, my name is Marco Montalbano and I'm a web developer. On this site you can discover more about me, my projects, my work and my cv.";
const socialImage = await getSocialImage(hero?.img ?? defaultCoverImage, Astro.url);
const isHomePage = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{websiteTitle}</title>
    <meta name="description" content={websiteDescription} />
    <meta property="og:title" content={websiteTitle} />
    <meta property="og:description" content={websiteDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage.url} />
    {
      socialImage.size != null && (
        <>
          <meta property="og:image:width" content={String(socialImage.size.width)} />
          <meta property="og:image:height" content={String(socialImage.size.height)} />
        </>
      )
    }
    {
      article != null ? (
        <>
          <meta property="og:type" content="article" />
          <meta property="article:published_time" content={article.publishedAt.toISOString()} />
          <meta property="article:modified_time" content={article.updatedAt.toISOString()} />
        </>
      ) : (
        <meta property="og:type" content="website" />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {isHomePage && <meta name="twitter:title" content="Hi everyone, my name is Marco and I'm a web developer." />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="color-scheme" content="light dark" />
    {/* Mirrors the system theme on `data-theme`, which astro-mermaid's `autoTheme` reads to theme diagrams. */}
    <script is:inline>
      const colorScheme = matchMedia('(prefers-color-scheme: dark)');

      const syncTheme = () => {
        document.documentElement.setAttribute('data-theme', colorScheme.matches ? 'dark' : 'light');
      };

      syncTheme();
      colorScheme.addEventListener('change', syncTheme);
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;700&family=Spinnaker&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  </head>
  <body>
    <Header hero={hero} />
    <div class="container">
      <slot />
    </div>
    <SimpleAnalytics />
  </body>
</html>
