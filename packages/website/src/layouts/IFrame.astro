---
import '../styles/global.css';

import { type Props as HeaderProps } from '../components/Header.astro';
import SimpleAnalytics from '../components/SimpleAnalytics.astro';
import defaultCoverImage from '../images/marcomontalbano.png';
import { getSocialImage } from '../lib/social-image';

export interface Props {
  /** Page title; " - Marco Montalbano" is appended, except when it is the site name itself. */
  title: string;
  /** Falls back to the site's own description. */
  description?: string;
  /** Only its image is used, as the link-preview image. */
  hero?: HeaderProps['hero'];
}

const mainTitle = 'Marco Montalbano';
const { title, description, hero } = Astro.props;

const websiteTitle = `${title != mainTitle ? `${title} - ` : ''}${mainTitle}`;
const websiteDescription =
  description ??
  "Hi everyone, my name is Marco Montalbano and I'm a web developer. On this site you can discover more about me, my projects, my work and my cv.";
const socialImage = await getSocialImage(hero?.img ?? defaultCoverImage, Astro.url);
---

<!doctype html>
<html lang="en" class="h-full bg-transparent!">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{websiteTitle}</title>
    <meta name="description" content={websiteDescription} />
    <meta property="og:title" content={websiteTitle} />
    <meta property="og:description" content={websiteDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage.url} />
    {
      socialImage.size != null && (
        <>
          <meta property="og:image:width" content={String(socialImage.size.width)} />
          <meta property="og:image:height" content={String(socialImage.size.height)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;700&family=Spinnaker&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full bg-transparent!">
    <div class="container h-full bg-transparent">
      <slot />
    </div>
    <SimpleAnalytics />
  </body>
</html>
