---
import { Image } from 'astro:assets';
import cn from 'classnames';
import profilePicture from '../images/marco-montalbano.jpg';
import type { Props as LayoutProps } from '../layouts/Layout.astro';
import { hasBlogPosts } from '../lib/blog';

interface Props {
  /** Set when the page has a hero: the bar turns white and sticks over it. Without one, the site name is the page's h1. */
  hero?: LayoutProps['hero'];
}

const { hero } = Astro.props;

/** Hides the "Blog" link while there is nothing published to read. */
const isBlogVisible = await hasBlogPosts();
const isBlogSelected = Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith('/blog/');

const TitleElement = hero == null ? 'h1' : 'div';
---

<header
  class={cn('top-0 w-full', {
    'sticky top-0 text-white backdrop-blur-md': hero != null,
  })}
>
  <div class="container">
    <nav class="flex items-center gap-2 md:gap-4 h-20">
      <div class="grow">
        <a href="/" class="flex justify-self-start">
          <TitleElement class="font-title text-lg md:text-3xl flex items-center gap-2 md:gap-4">
            <Image
              class="rounded-full w-5 h-5 md:w-8 md:h-8"
              alt="Marco Montalbano"
              src={profilePicture}
              width={512}
              height={512}
            />
            Marco Montalbano
          </TitleElement>
        </a>
      </div>
      <div class="flex md:text-lg gap-3 md:gap-8 items-center">
        {isBlogVisible && (
          <a
            href="/blog"
            aria-current={isBlogSelected ? 'page' : undefined}
            class={cn({ 'font-semibold underline underline-offset-4': isBlogSelected })}
          >
            Blog
          </a>
        )}
        <a href="https://github.com/marcomontalbano">GitHub</a>
        <a href="https://marcomontalbano.com/cv/cv-marco-montalbano.pdf">CV</a>
      </div>
    </nav>
  </div>
</header>
